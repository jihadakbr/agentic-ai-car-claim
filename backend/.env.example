# Salin berkas ini jadi `.env` lalu isi nilainya. Berkas `.env` tidak ikut masuk git.
# Semua isian di bawah opsional. Tanpa satu pun, sistem tetap jalan penuh memakai SQLite,
# detektor contoh, dan narasi susunan kode.

# Penyalaan agent. Groq didahulukan karena paling cepat, OpenRouter dipakai kalau Groq
# kena batas kuota.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Nama model bisa ditimpa, karena penyedia gratis kerap mengganti model yang tersedia.
# Daftar model Groq yang masih hidup: GET https://api.groq.com/openai/v1/models
# MODEL_GROQ=openai/gpt-oss-20b
# MODEL_OPENROUTER=openai/gpt-oss-20b:free

# Bobot model hasil training. Tanpa diisi, bobot dicari di backend/models/part.pt dan
# backend/models/damage.pt, jadi cukup menaruh berkasnya di sana lalu nyalakan ulang server.
# Selama salah satu belum ada, sistem memakai detektor contoh dan mengatakannya di banner.
# MODEL_PART=
# MODEL_DAMAGE=
# FOLDER_MODEL=models

# Templat STNK untuk pembangkit data uji, hasil scripts/siapkan_stnk_acuan.py.
# STNK_ACUAN=data/acuan/stnk-acuan.jpg

# Akun masuk. Kata sandi tiga akun contoh (surveyor, adjuster, admin) dan kunci penanda
# tangan token. Nilai bawaannya tertulis di repo publik, jadi isi sendiri di server yang
# bisa diakses orang lain.
# PASSWORD_DEMO=
# RAHASIA_TOKEN=

# Alamat database. Kosong berarti SQLite di berkas dev.db.
# DATABASE_URL=

# Penyimpanan foto. Kalau ketiganya terisi, foto ditulis ke Supabase Storage, bukan ke
# folder. Wajib diisi saat deploy, karena berkas di Hugging Face Space terhapus tiap
# Space dinyalakan ulang.
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_BUCKET=foto-klaim

# Alamat frontend yang diizinkan menghubungi backend. Kosong berarti semua diizinkan.
# ASAL_DIIZINKAN=http://localhost:3000

# Token Hugging Face, opsional, cuma menaikkan batas kecepatan unduh model.
# HF_TOKEN=
